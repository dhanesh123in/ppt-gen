{
  "name": "ppt-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design-system layer for Marp + pptxgenjs decks (tokens, Chart.js plots, layouts)",
  "bin": {
    "ppt-gen": "./bin/ppt-gen.mjs"
  },
  "scripts": {
    "ppt-gen": "node bin/ppt-gen.mjs",
    "build:pdf": "node bin/ppt-gen.mjs all decks/demo.md --engine marp",
    "build:pptx": "node bin/ppt-gen.mjs all decks/demo.md --format pptx --engine constructs",
    "build:constructs": "node bin/ppt-gen.mjs constructs decks/demo.md",
    "theme:compile": "node bin/ppt-gen.mjs compile-themes"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "chart.js": "^4.5.0",
    "csv-parse": "^6.1.0",
    "katex": "^0.16.47",
    "pptxgenjs": "^3.12.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.3.1",
    "@mermaid-js/mermaid-cli": "^11.15.0"
  }
}
